    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.183.1",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "^3.7.4",
    "tsx": "4.20.6",
